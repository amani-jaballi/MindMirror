{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and statistics",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "streak": { "type": "integer" },
        "lastActive": { "type": "object", "format": "google-firestore-timestamp" },
        "traitsProgress": { "type": "object" }
      },
      "required": ["uid", "email"]
    },
    "PersonalityType": {
      "title": "Personality Type",
      "description": "MBTI personality type description",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "strengths": { "type": "array" },
        "weaknesses": { "type": "array" },
        "careers": { "type": "array" }
      },
      "required": ["id", "code", "name"]
    },
    "Trait": {
      "title": "Trait",
      "description": "A psychological trait category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "iconName": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "A set of questions for a specific trait",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "traitId": { "type": "string" },
        "questions": { "type": "array" }
      },
      "required": ["id", "traitId", "questions"]
    },
    "QuizResult": {
      "title": "Quiz Result",
      "description": "User's result from taking a quiz",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "traitId": { "type": "string" },
        "score": { "type": "number" },
        "percentage": { "type": "integer" },
        "timestamp": { "type": "object", "format": "google-firestore-timestamp" }
      },
      "required": ["userId", "traitId", "score", "percentage", "timestamp"]
    },
    "MoodEntry": {
      "title": "Mood Entry",
      "description": "Daily mood tracking entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "moodType": { "type": "string" },
        "moodEmoji": { "type": "string" },
        "moodPercentage": { "type": "integer" },
        "answers": { "type": "object" },
        "timestamp": { "type": "object", "format": "google-firestore-timestamp" }
      },
      "required": ["userId", "moodType", "moodEmoji", "moodPercentage", "answers", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "personality_types/{id}": {
      "schema": "PersonalityType",
      "description": "MBTI types metadata"
    },
    "traits/{id}": {
      "schema": "Trait",
      "description": "Trait categories metadata"
    },
    "quizzes/{id}": {
      "schema": "Quiz",
      "description": "Quiz questions metadata"
    },
    "results/{id}": {
      "schema": "QuizResult",
      "description": "User quiz results"
    },
    "daily_moods/{id}": {
      "schema": "MoodEntry",
      "description": "User daily mood entries"
    }
  }
}
